MVI L,01H	; LED
MVI D,01H	; checks if we go up(1) or down(0)
MVI E,01H	; checks if we go up(1) or down(0), same as D
OPERATION_CHECK:
	LDA 2000H
	RRC
	RRC
	JC STOP
	RLC
	RLC
	JNC CYCLE
	MOUNTAIN:
		MOV A,D
		CPI 01H
		JNZ DOWN
	UP:
		MVI D,01H
		MVI E,01H
		MOV A,L
		CPI 80H
		JZ DOWN
		CMA
		STA 3000H
		CMA
		RLC 
		MOV L,A
		JMP OPERATION_CHECK
	DOWN:
		MVI D,00H
		MVI E,00H
		MOV A,L
		CPI 01H
		JZ UP
		CMA
		STA 3000H
		CMA
		RRC 
		MOV L,A
		JMP OPERATION_CHECK
	START:
		MVI L,01H
	CYCLE:
		MOV A,E
		CPI 01H
		JZ CYCLE_UP
	CYCLE_DOWN:
		MVI E,01H
		MOV A,L
		RLC
		RLC
		CMA
		STA 3000H
		CMA
		CPI 80H
		JZ START
		RLC 
		MOV L,A
		JMP OPERATION_CHECK
	CYCLE_UP:
		MOV A,L
		CMA
		STA 3000H
		CMA
		CPI 80H
		JZ START
		RLC 
		MOV L,A
		JMP OPERATION_CHECK
	STOP:
		JMP OPERATION_CHECK		

END