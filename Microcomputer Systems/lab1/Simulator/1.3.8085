LXI B,03E8H
PROGRAM:
	LDA 2000H
	CPI C8H
	JNC LED
	CPI 63H
	JC START
	SUI 64H
START:
	MVI E,FFH
DECA:
	INR E
	SUI 0AH
	JNC DECA
	ADI 0AH
	MOV D,A
	MOV A,E
	RLC 
	RLC 
	RLC
	RLC
	ORA D
	CMA
	STA 3000H
	JMP PROGRAM
LED:
	MVI A,F0H
	STA 3000H
	CALL DELB 
	MVI A,FFH
	STA 3000H
	CALL DELB
	JMP PROGRAM
END