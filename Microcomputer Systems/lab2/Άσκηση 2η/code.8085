START:
	LDA 2000H
	RRC
	JC START	; if 1st is ON loop

STATE1:		; 1st OFF
	LDA 2000H
	RRC
	JNC STATE1

STATE2:		; 2nd is ON
	LDA 2000H
	RRC
	JC STATE2
	CALL DISPLAY
	JMP END 
	;JMP START
	
	
DISPLAY:
	PUSH PSW
	PUSH D
	PUSH B
	MVI D,00H
	MVI E,00H
	LXI B,1388H		; BC = 5000d
	
CHECK1:
	MVI E,00H	
	LDA 2000H
	RRC
	JNC A1

CHECK2:
	MVI E,01H
	LDA 2000H
	RRC	
	JC A1
	MVI E,00H
	MVI D,00H	
A1:	
	XRA A			; A = 00H
	STA 3000H
	CALL DELB
	CMA 
	STA 3000H
	CALL DELB
	INR D
	MOV A,D
	CPI 0FH
	JZ R_END
	MOV A,E
	CPI 00H
	JZ CHECK1
	JNZ CHECK2

R_END:	
	POP B
	POP D
	POP PSW
	RET

END:
	END
	


	