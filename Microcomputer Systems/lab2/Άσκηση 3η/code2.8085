LXI B,1000H

START:
	MVI D,00H
	LDA 2000H
	CALL KIND
	CPI 00H
	JZ ERROR
	CPI 09H
	JP ERROR
	CPI 05H
	JP LAST_4_BITS

FIRST_4_BITS:
	MOV A,D
	CPI 04H
	JZ START
	MVI A,F0H
	STA 3000H
	CALL DELB
	MVI A,FFH
	STA 3000H
	CALL DELB
	INR D
	JMP FIRST_4_BITS

LAST_4_BITS:
	MOV A,D
	CPI 04H
	JZ START
	MVI A,0FH
	STA 3000H
	CALL DELB
	MVI A,FFH
	STA 3000H
	CALL DELB
	INR D
	JMP LAST_4_BITS

ERROR:
	MVI A,FEH
	STA 3000H
	CALL DELB
	JMP START
END