IN 10H
LXI H,0900H
MVI A,FFH		;A = 255
LXI D,0000H 		;WE COUNT THE ZEROS WITH D
MVI C,00H

FOR:
	CPI 00H
	JZ PUT_ZERO
	MOV M,A
	DCR A
	INX H
	JMP FOR

PUT_ZERO:		;TO PUT ZERO IN THE LAST POSITION
	MOV M,A

MVI A,00H		;A = 0 ,IN ORDER TO CHECK
CHECK:
	CPI FFH
	JZ EXIT
	CMP M
	JNZ ERROR
	CPI 20H
	JM A1
	CPI 71H
	JP A1
	INR C

A1:	DCX H 
	INR A
	JMP CHECK

EXIT:
	CMP M
	JNZ ERROR
	CMA
	;STA 3000H	;IF ALL OK -> 8 LEDS WILL OPEN
	CMA
	PUSH B		;WE SAVE C FOR THE COUNTER
	MVI C,00H
	JMP COUNTER

ERROR:
	MVI A,FEH 	
	;STA 3000H	;IF THERE IS AN ERROR THE 1ST LED WILL OPEN

	JMP END

COUNTER:			;A = 0 AND HL = 0900
	MOV A,C		;C -> COUNTER
	CALL COUNT_ZEROS
	INX H
	INR C
	MOV A,C
	CPI 00H
	JZ DISPLAY
	JMP COUNTER

DISPLAY:
	POP B			;FROM COUNTER
	MOV A,D		;HERE YOU CAN PUT D,E OR C , IN ORDER TO
				;SEE THE RESULTS 
	CMA			;WE EXPECT 1024D = 0000010000000000 B
	STA 3000H		;D = 00000100 , E = 00000000 , C = 01010001
	JMP END

COUNT_ZEROS:	PUSH PSW	;WE SAVE A AND FLAGS
		PUSH B		;WE SAVE B,C
		MVI B,00H	;WE CAN CHANGE A,B AND C IN THE ROUTINE
				;B IS THE COUNTER FOR THE 8 BITS
		
		MOV C,M	;C = M = ((H)(L)) FROM COUNTER
	START:	
		MOV A,B	
		CPI 08H
		JZ RETURN		
	
		MOV A,C	
		RAR
		MOV C,A	;WE UPDATE C ,BECAUSE WE RIGTH SHIFTED A
		JC CONT
		INX D
	CONT:	
		INR B
		JMP START
	RETURN:	
		POP B
		POP PSW 
		RET

BETWEEN:	
		PUSH PSW
		
		MOV A,M
		CPI 20H
		 
END: ?
	END