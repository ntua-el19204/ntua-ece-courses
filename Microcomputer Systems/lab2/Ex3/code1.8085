START:
	LDA 2000H
	MVI D,00H		; D is RLC counter
	MVI E,00H
	CPI 00H	
	JZ DISPLAY
BIT1:	
	RLC
	INR D			; CY flag not affected
	JNC BIT1		; if bit = 0 get the next one
	MVI A,00H
MAKE:
	MOV E,A		; save A
	MOV A,D
	CPI 00H
	JZ DISPLAY
	DCR D
	MOV A,E		; get A back
	INR A
	RRC
	JMP MAKE
DISPLAY:
	MOV A,E
	CMA
	STA 3000H
	JMP START

END
